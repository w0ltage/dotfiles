#!/usr/bin/zsh

claude-api() {
  ANTHROPIC_BASE_URL=$PROXY_BASE_URL \
  ANTHROPIC_API_KEY=$PROXY_API_KEY \
  claude "$@"
}

proxy() {
  (
    export ANTHROPIC_BASE_URL=$PROXY_BASE_URL
    export ANTHROPIC_API_KEY=$PROXY_API_KEY
    eval "$@"
  )
}


#!/bin/bash

# ==== SketchyBar Configuration ====
# Streamlined and consolidated configuration

# Load colors and configuration paths
source "$CONFIG_DIR/colors.sh"

PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

# Fallback colors if not defined
: "${FG_COLOR:=0xffffffff}"
: "${FG_MUTED:=0xccffffff}"
: "${FG_STRONG:=0xffffffff}"
: "${WARN_COLOR:=0xffff4d4d}"

# ==== BAR CONFIGURATION ====
bar_config=(
  position=top
  height=32
  blur_radius=20
  sticky=on
  padding_left=10
  padding_right=10
  # Using transparent background with blur instead of solid color
  # color=$BAR_COLOR
)

sketchybar --bar "${bar_config[@]}"

# ==== DEFAULT ITEM PROPERTIES ====
# These settings apply to all items unless overridden
default_config=(
  padding_left=5
  padding_right=5
  icon.font="SF Pro:SemiBold:12.0"
  icon.color=$FG_MUTED
  icon.padding_left=6
  icon.padding_right=4
  label.font="SF Pro:SemiBold:15.0"
  label.color=$FG_MUTED  
  label.padding_left=4
  label.padding_right=8
  background.color=$ITEM_BG_COLOR
  background.corner_radius=5
  background.height=24
  background.padding_left=4
  background.padding_right=4
  background.drawing=off
  updates=when_shown
)

sketchybar --default "${default_config[@]}"

# ==== LEFT SIDE ITEMS ====
source "$ITEM_DIR/spaces.sh"
source "$ITEM_DIR/front_app.sh"

# ==== RIGHT SIDE ITEMS ====
# Organized in logical groups: [DATE TIME] [KB VOL] [CPU RAM]

# === GROUP 1: DATE TIME ===
sketchybar --add item calendar right \
           --set calendar icon=􀧞 \
                          update_freq=30 \
                          label.color=$COLOR_SECONDARY \
                          icon.color=$COLOR_SECONDARY \
                          padding_right=15 \
                          script="$PLUGIN_DIR/system_monitor.sh calendar"

# === GROUP 2: KEYBOARD & VOLUME ===
sketchybar --add item volume right \
           --set volume label.color=$COLOR_SECONDARY \
                        icon.color=$COLOR_SECONDARY \
                        script="$PLUGIN_DIR/system_monitor.sh volume" \
                        padding_right=15 \
           --subscribe volume volume_change

sketchybar --add item keyboard right \
           --set keyboard icon.drawing=off \
                          label.font="SF Pro:Semibold:14.0" \
                          label.color=$COLOR_SECONDARY \
                          script="$PLUGIN_DIR/system_monitor.sh keyboard" \
           --add event keyboard_change "AppleSelectedInputSourcesChangedNotification" \
           --subscribe keyboard keyboard_change

# === GROUP 3: SYSTEM MONITORING ===
sketchybar --add item memory right \
           --set memory update_freq=2 \
                        icon=􀫦 \
                        label.color=$COLOR_SECONDARY \
                        icon.color=$COLOR_SECONDARY \
                        script="$PLUGIN_DIR/system_monitor.sh memory" \
                        padding_right=15 

sketchybar --add item cpu right \
           --set cpu update_freq=2 \
                     icon=􀧓 \
                     label.color=$COLOR_SECONDARY \
                     icon.color=$COLOR_SECONDARY \
                     script="$PLUGIN_DIR/system_monitor.sh cpu"


# ==== FINALIZE CONFIGURATION ====
# Force all scripts to run the first time
sketchybar --update
